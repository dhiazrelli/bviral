# =============================================================================
# BViral Control Center — environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values for your environment.
# This file is checked into the repo; the real `.env` is in .gitignore.
#
# Generate strong secrets with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# =============================================================================

# ----------------------------- Core API server -------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
HOST=0.0.0.0
PORT=3001
ADMIN_TOKEN=change-me-in-prod
CORS_ORIGINS=http://localhost:5173
DASHBOARD_URL=http://localhost:5173

# Required: AES-256 key for at-rest encryption of OAuth tokens stored in
# the `accounts` table. Generate with the snippet at the top of this file.
# In production the API server refuses to boot without this set.
TOKEN_ENCRYPTION_KEY=

# ----------------------------- Supabase --------------------------------------
# These VITE_-prefixed values are picked up by the dashboard at build time.
# The API server reads them too (or the un-prefixed equivalents).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VIDEO_BUCKET=videos

# ----------------------------- Redis (BullMQ queues) -------------------------
REDIS_URL=redis://127.0.0.1:6379

# ----------------------------- YouTube OAuth ---------------------------------
# Required for the YouTube connect flow. Obtain from
#   https://console.cloud.google.com → APIs & Services → Credentials
# Leave blank to disable YouTube; the API server will return 503 on the connect
# route instead of crashing at boot.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/v1/accounts/youtube/callback

# ----------------------------- TikTok OAuth ----------------------------------
# Obtain from https://developers.tiktok.com → My apps → your app
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/api/v1/accounts/tiktok/callback

# ----------------------------- Meta (Facebook + Instagram) -------------------
# Obtain from https://developers.facebook.com → My apps → Settings → Basic
# Either META_APP_* or APP_* aliases are accepted.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/api/v1/accounts/meta/callback

# ----------------------------- Dashboard (Vite) ------------------------------
# These are read by Vite at build time.
VITE_API_BASE_URL=http://localhost:3001
VITE_BVIRAL_VIDEO_EDITOR_URL=http://localhost:3000/projects
