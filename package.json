{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/bviral-dashboard run dev",
    "dev:dashboard": "pnpm --filter @workspace/bviral-dashboard run dev",
    "dev:worker:posts": "pnpm --filter @workspace/api-server run worker:posts",
    "dev:worker:virality": "pnpm --filter @workspace/api-server run worker:virality",
    "dev:video-editor": "pnpm -C artifacts/openvideo --ignore-workspace run dev",
    "build:video-editor": "pnpm -C artifacts/openvideo --ignore-workspace run build",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
